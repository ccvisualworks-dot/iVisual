<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Services | iVisual.cc</title><meta name="description" content="iVisual.cc — creative video, design, websites, e-commerce and AI-assisted work."><link rel="stylesheet" href="style.css"></head><body>
<header class="site-header">
<a class="brand" href="index.html" aria-label="iVisual.cc home"><span class="brand-i">i</span><span class="brand-word">Visual<span class="brand-cc">.cc</span></span></a>
<button class="menu" aria-label="Open menu" aria-expanded="false">☰</button>
<nav class="nav">
<a href="index.html">Home</a><a href="about.html">About</a><a href="services.html">Services</a><a href="work.html">My Work</a><a href="skills.html">Skills</a><a class="nav-cta" href="contact.html">Work With Me</a>
</nav></header>
<main class="page"><span class="orb one"></span><span class="orb two"></span>
<section class="page-hero"><div class="container"><p class="eyebrow">Services</p><h1>Choose what you need. Build what you imagine.</h1><p class="lead">Flexible creative and digital support for individuals and small businesses.</p></div></section>
<section class="section"><div class="container grid two">
<article class="card service-card"><span class="number">01</span><div class="icon">🎬</div><h2>Video Editing</h2><p class="muted">Editing, pacing, visual polish and story shaping for social, promotional and personal video.</p></article>
<article class="card service-card"><span class="number">02</span><div class="icon">✦</div><h2>AI Creative</h2><p class="muted">AI-assisted image, video, concept and creative exploration to help turn ideas into visuals.</p></article>
<article class="card service-card"><span class="number">03</span><div class="icon">◫</div><h2>Website Design</h2><p class="muted">Clean, responsive websites designed around your message, audience and goals.</p></article>
<article class="card service-card"><span class="number">04</span><div class="icon">🛒</div><h2>E-Commerce Support</h2><p class="muted">Practical support for online stores, product presentation and digital customer journeys.</p></article>
</div></section>
</main>
<footer><div class="footer-brand"><span class="brand-i">i</span><strong>Visual<span class="brand-cc">.cc</span></strong></div><div>Creative video, design, websites, e-commerce & AI-assisted work.</div></footer>
<script>
document.addEventListener('DOMContentLoaded',()=>{
  const menu=document.querySelector('.menu'), nav=document.querySelector('.nav');
  if(menu&&nav){menu.addEventListener('click',()=>{const open=nav.classList.toggle('open');menu.setAttribute('aria-expanded',open)})}
  const robot=document.querySelector('.robot-bg'), sound=document.querySelector('.sound');
  if(robot&&sound){
    robot.playbackRate=.72; robot.muted=true; robot.volume=0;
    let timer;
    const fade=(to,done)=>{clearInterval(timer);const from=robot.volume,steps=12,delta=(to-from)/steps;let i=0;timer=setInterval(()=>{i++;robot.volume=Math.max(0,Math.min(1,from+delta*i));if(i>=steps){clearInterval(timer);robot.volume=to;if(done)done()}},30)};
    const off=()=>{fade(0,()=>{robot.muted=true;sound.textContent='🔊 Hear the robot';sound.setAttribute('aria-label','Hear the robot')})};
    sound.addEventListener('click',e=>{e.stopPropagation();if(robot.muted){robot.muted=false;robot.play().then(()=>fade(1,()=>{sound.textContent='🔇 Stop the robot voice';sound.setAttribute('aria-label','Stop the robot voice')})).catch(()=>off())}else off()});
    robot.addEventListener('click',off);
  }
  const form=document.querySelector('#enquiryForm');
  if(form)form.addEventListener('submit',e=>{e.preventDefault();const d=new FormData(form);const msg=`Hi iVisual.cc, I would like to enquire about a ${d.get('project')} project.%0A%0AName: ${encodeURIComponent(d.get('name'))}%0AEmail: ${encodeURIComponent(d.get('email'))}%0AProject details: ${encodeURIComponent(d.get('message'))}`;window.open('https://wa.me/60162818368?text='+msg,'_blank')});
});
</script></body></html>